# Configuration inventory only: every placeholder must remain blank.
# Export selected settings privately; dotnet does not automatically load this file.
# Never commit a filled .env, credential, real PII or token. Zero-config demo needs no keys.
# Live provider writes require separate owner execution. Settings are process-wide unless stated.
# Source/defaults: products/civicops/Services; setup: docs/ONBOARDING_MUNICIPALITY.md.
# Internal SMOKE_*, PG* and K6_BROWSER_* values are generated by isolated test harnesses.
# Generic OS/CI variables are not app configuration. Standard optional OTEL SDK knobs beyond
# this supported inventory may be supplied privately following the pinned SDK documentation.

# Listener URLs; local demo http://localhost:5080; container listens on 8080.
ASPNETCORE_URLS=
# Framework port shorthand; deployment assets fix 8080; URLS takes precedence.
ASPNETCORE_HTTP_PORTS=
# ASP.NET environment; use Production behind configured HTTPS ingress.
ASPNETCORE_ENVIRONMENT=
# Explicit synthetic demo; true forces simulated providers, deterministic AI and email outbox.
CIVICOPS_DEMO_MODE=
# Private writable durable data directory; default product Data; file mode requires one owner process.
CIVICOPS_DATA_DIR=
# Default-tenant bootstrap identities: unique name:SHA256(token) pairs separated by semicolons.
CIVICOPS_DISPATCHERS=
# Legacy default-tenant bootstrap bearer; prefer hashed named identities or scoped accounts.
CIVICOPS_DISPATCH_TOKEN=
# Positive requests/minute per intake partition, default 60; maximum 10000.
CIVICOPS_INTAKE_LIMIT=
# Positive requests/minute per dispatcher partition, default 120; maximum 10000.
CIVICOPS_DISPATCH_LIMIT=
# warn or block; demo defaults warn, production block; skill/availability gaps always block.
CIVICOPS_CERT_POLICY=
# Separate default-tenant training clients: name:SHA256(token) pairs; semicolon separated.
CIVICOPS_TRAINING_CLIENTS=
# Training requests/minute per client, default 60; maximum 10000.
CIVICOPS_TRAINING_LIMIT=
# Passing simulation score 0-100, default 80; sign-off is also required for grants.
CIVICOPS_TRAINING_PASS_SCORE=
# Simulation certificate grants enabled by default; false disables automatic grants.
CIVICOPS_TRAINING_CERTIFICATIONS_ENABLED=
# Closed-case snapshot retention 1-36500 days; blank/invalid disables; preserves immutable audit.
CIVICOPS_RETENTION_DAYS=
# Public HTTPS origin used for provider tools/webhooks; no credential/query/fragment.
PUBLIC_BASE_URL=
# Comma list of providers allowed to call real services while CIVICOPS_DEMO_MODE=true: llm, elevenlabs. Blank keeps demo fully simulated.
CIVICOPS_DEMO_LIVE_PROVIDERS=
# Reasoning provider or ordered pair (primary,secondary): azure-openai, gemini, openai-compatible (default, uses CIVICOPS_LLM_BASE_URL).
CIVICOPS_LLM_PROVIDER=
# Azure OpenAI resource endpoint, https://<resource>.openai.azure.com; no key or query.
CIVICOPS_AZURE_OPENAI_ENDPOINT=
# Azure OpenAI deployment name (for example a gpt-5-mini deployment).
CIVICOPS_AZURE_OPENAI_DEPLOYMENT=
# Azure OpenAI data-plane API version; default 2025-04-01-preview.
CIVICOPS_AZURE_OPENAI_API_VERSION=
# Azure auth: managed-identity (default without CIVICOPS_LLM_API_KEY) or key (uses CIVICOPS_LLM_API_KEY as api-key header).
CIVICOPS_AZURE_OPENAI_AUTH=
# Optional client ID of a user-assigned managed identity; blank uses the system-assigned identity.
CIVICOPS_AZURE_OPENAI_CLIENT_ID=
# Completion budget including hidden reasoning tokens; default 4000, clamped 256-16000.
CIVICOPS_LLM_MAX_COMPLETION_TOKENS=
# Azure reasoning effort: none, minimal, low (default), medium or high.
CIVICOPS_LLM_REASONING_EFFORT=
# Advisory three-seat intake room (coordinator/implementer/reviewer, ported from the Tablekeeper Band classroom); true enables it.
CIVICOPS_INTAKE_ROOM=
# Whole-room timeout in ms, default 25000, clamped 1000-60000; on timeout every seat is labelled deterministic fallback.
CIVICOPS_INTAKE_ROOM_TIMEOUT_MS=
# Hard spend cap: live LLM decisions per UTC day, default 2000; 0 disables live LLM.
CIVICOPS_LLM_DAILY_CALL_CAP=
# Hard spend cap: live LLM decisions per UTC month, default 20000.
CIVICOPS_LLM_MONTHLY_CALL_CAP=
# Hard spend cap: ElevenLabs sessions per UTC day, default 100; 0 disables live voice.
CIVICOPS_VOICE_DAILY_SESSION_CAP=
# Hard spend cap: ElevenLabs sessions per UTC month, default 1000.
CIVICOPS_VOICE_MONTHLY_SESSION_CAP=
# Google AI Studio API key for CIVICOPS_LLM_PROVIDER entry gemini; never sent to the browser.
GEMINI_API_KEY=
# Absolute private mounted-file path for GEMINI_API_KEY; overrides environment, invalid file fails closed.
GEMINI_API_KEY_FILE=
# Gemini model, default gemini-2.5-flash.
GEMINI_MODEL=
# Optional label for Gemini runs; default Google Gemini (<model>).
GEMINI_PROVIDER_LABEL=
# Protected OpenAI-compatible base URL (optional /v1); blank selects deterministic fallback.
CIVICOPS_LLM_BASE_URL=
# Full public HTTPS Chat Completions endpoint for optional ElevenLabs custom LLM provisioning.
CIVICOPS_LLM_PUBLIC_URL=
# Reasoning model ID; default Qwen/Qwen3-8B; owner must verify model licence and hardware.
CIVICOPS_LLM_MODEL=
# Optional private inference bearer; never exposed to resident browser.
CIVICOPS_LLM_API_KEY=
# Accurate provider/hardware label; default explicitly says hardware unverified.
CIVICOPS_LLM_PROVIDER_LABEL=
# Per reasoning attempt timeout, default 10000 ms, clamped 250-60000; at most two attempts.
CIVICOPS_LLM_TIMEOUT_MS=
# Restricted private workspace API key; no key keeps channels honestly simulated/disabled.
ELEVENLABS_API_KEY=
# Optional API origin override; default https://api.elevenlabs.io.
ELEVENLABS_API_BASE=
# Resident agent ID from owner-managed workspace; blank leaves simulated intake.
ELEVENLABS_AGENT_ID=
# Separate callback agent ID; consent and configured phone routing are required.
ELEVENLABS_CALLBACK_AGENT_ID=
# Owner-linked provider phone number ID for callbacks.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Owner-selected phone provider; see docs/ELEVENLABS_SETUP.md for supported setup.
ELEVENLABS_PHONE_PROVIDER=
# public, signed-url or webrtc; private credentials issued by backend only after Start.
ELEVENLABS_SESSION_MODE=
# HMAC secret for incoming ElevenLabs post-call notifications.
ELEVENLABS_WEBHOOK_SECRET=
# Reviewed existing workspace webhook ID; provisioner references it.
ELEVENLABS_POST_CALL_WEBHOOK_ID=
# Backend tool bearer; legacy default tenant only; scoped tenant accounts preferred.
CIVICOPS_ELEVENLABS_TOOL_SECRET=
# Workspace secret reference holding tool bearer, not its value.
ELEVENLABS_WORKSPACE_TOOL_SECRET_ID=
# Optional workspace secret reference for protected custom AMD reasoning endpoint.
ELEVENLABS_WORKSPACE_LLM_SECRET_ID=
# Owner-approved voice ID used by provisioner; live pronunciation requires validation.
ELEVENLABS_VOICE_ID=
# Comma-separated allowed widget hostnames; review public exposure before live use.
ELEVENLABS_WIDGET_ALLOWED_HOSTS=
# Owner-verified transfer destination; phone/callback behaviour unverified live.
ELEVENLABS_TRANSFER_PHONE=
# Zendesk account subdomain only; incomplete configuration selects simulated transport.
ZENDESK_SUBDOMAIN=
# Integration service-user email used with API-token auth; never resident data.
ZENDESK_EMAIL=
# Restricted private Zendesk API token; use email+token OR OAuth token.
ZENDESK_API_TOKEN=
# Private existing Zendesk OAuth bearer; automatic refresh is not implemented.
ZENDESK_OAUTH_TOKEN=
# Incoming webhook signature secret; configure reviewed trigger mapping separately.
ZENDESK_WEBHOOK_SECRET=
# outbox (default) or smtp; demo always outbox; SMTP is owner-pending and never required.
CIVICOPS_EMAIL_MODE=
# Configured sender address; outbox fallback uses example.invalid.
CIVICOPS_EMAIL_FROM=
# Optional staff notification recipients; see email service recipient validation.
CIVICOPS_EMAIL_NOTIFY_TO=
# Optional SMTP hostname; only complete non-demo smtp configuration sends.
CIVICOPS_EMAIL_SMTP_HOST=
# SMTP port 1-65535; only complete smtp group enables delivery.
CIVICOPS_EMAIL_SMTP_PORT=
# Private SMTP service-account user.
CIVICOPS_EMAIL_SMTP_USER=
# Private SMTP service-account password; external SMTP execution unverified.
CIVICOPS_EMAIL_SMTP_PASSWORD=
# SMTP TLS flag; default true; owner must validate transport security.
CIVICOPS_EMAIL_USE_SSL=
# Owner-reviewed ROCm/vLLM image digest; Compose/chart pinned, legacy helper default latest.
CIVICOPS_VLLM_IMAGE=
# Legacy AMD helper loopback port, default 8000; no daemon available on this box.
CIVICOPS_VLLM_PORT=
# Legacy helper/Compose tensor parallel size, default 1; match actual GPU count.
CIVICOPS_VLLM_TENSOR_PARALLEL=
# Legacy AMD helper model cache directory, default temporary cache.
CIVICOPS_MODEL_CACHE=
# Local demo seed/utility target, default http://127.0.0.1:5080.
CIVICOPS_BASE_URL=
# Private temporary tools/evidence root; defaults to the operating-system temp directory.
TMPDIR=
# Browser QA target; smoke harness chooses a disposable loopback origin.
CIVICOPS_BROWSER_BASE_URL=
# Existing Chrome/Chromium executable for local browser/k6 QA.
CIVICOPS_CHROME_PATH=
# Pinned playwright-core module path; optional local QA only.
CIVICOPS_PLAYWRIGHT_MODULE=
# entra, google or generic; entirely blank OIDC group disables SSO.
CIVICOPS_OIDC_PROVIDER=
# Specific trusted HTTPS issuer; Entra/Google presets derive this when omitted.
CIVICOPS_OIDC_AUTHORITY=
# Owner-registered confidential OIDC client ID; required for configured SSO.
CIVICOPS_OIDC_CLIENT_ID=
# Private OIDC client secret; required with client ID and explicit role/group map.
CIVICOPS_OIDC_CLIENT_SECRET=
# Specific Entra directory GUID; common/organizations are rejected.
CIVICOPS_OIDC_DIRECTORY_ID=
# Trusted role claim name, default roles; Google may use explicit sub allowlist.
CIVICOPS_OIDC_ROLE_CLAIM=
# Trusted group claim name, default groups; no automatic directory group sync.
CIVICOPS_OIDC_GROUP_CLAIM=
# Single municipality claim name, default municipality_id; tenant must exist.
CIVICOPS_OIDC_TENANT_CLAIM=
# External-value=local-role[,local-role] pairs, semicolon separated; deny unmapped users.
CIVICOPS_OIDC_ROLE_MAP=
# Trusted external-group=local-role[,local-role] pairs, semicolon separated.
CIVICOPS_OIDC_GROUP_MAP=
# Optional fixed municipality ID for the process-wide issuer profile.
CIVICOPS_OIDC_TENANT_ID=
# Optional exact Google Workspace hd claim restriction; not a role assignment.
CIVICOPS_OIDC_HOSTED_DOMAIN=
# Staff session lifetime, default 480 minutes; validated 5-1440; restart expires sessions.
CIVICOPS_OIDC_SESSION_MINUTES=
# SHA256 hash of private break-glass bootstrap bearer; never raw token.
CIVICOPS_BOOTSTRAP_ADMIN_TOKEN_HASH=
# Bootstrap administrator municipality; default default tenant.
CIVICOPS_BOOTSTRAP_ADMIN_TENANT=
# Authentication attempts/minute per partition, default 20; maximum 10000.
CIVICOPS_AUTH_LIMIT=
# Authenticated tool requests/minute per partition, default 120; maximum 10000.
CIVICOPS_TOOL_LIMIT=
# env (default) or files; explicit mounted *_FILE overrides env in both modes.
CIVICOPS_SECRET_PROVIDER=
# Absolute private mounted-file path for CIVICOPS_OIDC_CLIENT_SECRET; overrides environment, invalid file fails closed.
CIVICOPS_OIDC_CLIENT_SECRET_FILE=
# Absolute private mounted-file path for CIVICOPS_LLM_API_KEY; overrides environment, invalid file fails closed.
CIVICOPS_LLM_API_KEY_FILE=
# Absolute private mounted-file path for ELEVENLABS_API_KEY; overrides environment, invalid file fails closed.
ELEVENLABS_API_KEY_FILE=
# Absolute private mounted-file path for CIVICOPS_ELEVENLABS_TOOL_SECRET; overrides environment, invalid file fails closed.
CIVICOPS_ELEVENLABS_TOOL_SECRET_FILE=
# Absolute private mounted-file path for ELEVENLABS_WEBHOOK_SECRET; overrides environment, invalid file fails closed.
ELEVENLABS_WEBHOOK_SECRET_FILE=
# Absolute private mounted-file path for ZENDESK_API_TOKEN; overrides environment, invalid file fails closed.
ZENDESK_API_TOKEN_FILE=
# Absolute private mounted-file path for ZENDESK_OAUTH_TOKEN; overrides environment, invalid file fails closed.
ZENDESK_OAUTH_TOKEN_FILE=
# Absolute private mounted-file path for ZENDESK_WEBHOOK_SECRET; overrides environment, invalid file fails closed.
ZENDESK_WEBHOOK_SECRET_FILE=
# Absolute private mounted-file path for CIVICOPS_EMAIL_SMTP_PASSWORD; overrides environment, invalid file fails closed.
CIVICOPS_EMAIL_SMTP_PASSWORD_FILE=
# Absolute private mounted-file path for CIVICOPS_DISPATCH_TOKEN; overrides environment, invalid file fails closed.
CIVICOPS_DISPATCH_TOKEN_FILE=
# Absolute private mounted-file path for CIVICOPS_DISPATCHERS; overrides environment, invalid file fails closed.
CIVICOPS_DISPATCHERS_FILE=
# Absolute private mounted-file path for CIVICOPS_TRAINING_CLIENTS; overrides environment, invalid file fails closed.
CIVICOPS_TRAINING_CLIENTS_FILE=
# Absolute private mounted-file path for CIVICOPS_BOOTSTRAP_ADMIN_TOKEN_HASH; overrides environment, invalid file fails closed.
CIVICOPS_BOOTSTRAP_ADMIN_TOKEN_HASH_FILE=
# Owner-approved public Information Officer contact shown in versioned purpose notice.
CIVICOPS_INFORMATION_OFFICER_CONTACT=
# Independent closed-case contact retention 1-36500 days; blank disables; not full erasure.
CIVICOPS_PII_RETENTION_DAYS=
# file (zero-config default) or postgres; all durable stores use selected backend.
CIVICOPS_STORAGE=
# Private Npgsql connection string; required for postgres; production certificate verification required.
CIVICOPS_DATABASE_URL=
# Absolute private mounted-file path for CIVICOPS_DATABASE_URL; overrides environment, invalid file fails closed.
CIVICOPS_DATABASE_URL_FILE=
# Disposable PostgreSQL contract-suite target, set by with_ephemeral_pg.sh; never production.
CIVICOPS_TEST_DATABASE_URL=
# Private audit-export HMAC key; key custody/external anchoring are owner responsibilities.
CIVICOPS_AUDIT_SIGNING_KEY=
# Absolute private mounted-file path for CIVICOPS_AUDIT_SIGNING_KEY; overrides environment, invalid file fails closed.
CIVICOPS_AUDIT_SIGNING_KEY_FILE=
# Non-secret signing-key identifier included in manifests for custody/rotation.
CIVICOPS_AUDIT_SIGNING_KEY_ID=
# Private exclusive local audit export directory; no cloud locking provided.
CIVICOPS_AUDIT_EXPORT_DIR=
# off, console or otlp; blank uses otlp only with non-demo common endpoint; demo suppresses OTLP.
CIVICOPS_TELEMETRY=
# General provider timeout, default 5000 ms; clamped 250-20000; AI has separate setting.
CIVICOPS_PROVIDER_TIMEOUT_MS=
# Readiness pending-delivery threshold, default 1000; clamped 0-10000.
CIVICOPS_OUTBOX_READY_MAX=
# Telemetry service identity, default civicops; no resident information.
OTEL_SERVICE_NAME=
# Optional deployment version in telemetry resources.
OTEL_SERVICE_VERSION=
# Optional standard comma-separated key=value resource attributes; never secrets/PII.
OTEL_RESOURCE_ATTRIBUTES=
# Private collector endpoint; no application Prometheus scrape route.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard exporter protocol; local smoke uses http/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=
# Private optional collector auth headers; not covered by mounted-file secret adapter.
OTEL_EXPORTER_OTLP_HEADERS=
# Optional standard per-signal trace collector endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional standard per-signal metric collector endpoint.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Optional standard per-signal log collector endpoint.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# true disables telemetry SDK export; JSON application logs remain.
OTEL_SDK_DISABLED=
# PostgreSQL 17 client/bin directory; default /usr/lib/postgresql/17/bin.
CIVICOPS_PG_BIN=
# Optional age public recipient; encryption requires owner-managed age tool/key custody.
CIVICOPS_BACKUP_AGE_RECIPIENT=
# Private external age identity path for restores; never include key in repository.
CIVICOPS_BACKUP_AGE_IDENTITY_FILE=
# Explicit trusted ingress CIDRs; blank trusts no proxy; universal ranges rejected.
CIVICOPS_TRUSTED_PROXY_NETWORKS=
# Private Compose env-file path; interpolation also needs shell or --env-file values.
CIVICOPS_COMPOSE_ENV_FILE=
# Locally built/owner-published app image; Compose default civicops:round7.
CIVICOPS_APP_IMAGE=
# Compose loopback host port, default 5080; terminate HTTPS at approved ingress.
CIVICOPS_COMPOSE_HTTP_PORT=
# Compose PostgreSQL database name, default civicops.
POSTGRES_DB=
# Compose PostgreSQL user, default civicops; use least privilege in production.
POSTGRES_USER=
# Private Compose PostgreSQL password; mandatory; trust auth never used for deployment.
POSTGRES_PASSWORD=
# Fixed Compose init invariant --auth-host=scram-sha-256; asset literal, not an operator override.
POSTGRES_INITDB_ARGS=
# Directory for synthetic k6 evidence; default new temporary directory.
CIVICOPS_LOADTEST_RESULTS=
# Harness-generated loopback k6 target; direct execution rejects remote targets.
CIVICOPS_LOADTEST_BASE_URL=
# Harness-generated per-scenario k6 JSON result path.
CIVICOPS_LOADTEST_SUMMARY=
# Private temporary pinned Spectral tools directory; API verification only.
CIVICOPS_SPECTRAL_TOOLS_DIR=
# Pinned axe-core script path used only for browser accessibility QA.
CIVICOPS_AXE_CORE_PATH=
# ASP.NET host allowlist; owner-approved municipal hostnames in production.
AllowedHosts=
# QA only: 1 publishes approved admin/control-room/timeline captures to docs/media.
CIVICOPS_UPDATE_MEDIA=
# QA only: age enables wrong-key/encrypted recovery drill with synthetic data.
CIVICOPS_SMOKE_ENCRYPTION=
# Harness-owned safety marker; never set manually or use with a production database.
CIVICOPS_EPHEMERAL_PG=
# Harness-owned disposable cluster path used by shutdown/restart smoke; never set manually.
CIVICOPS_EPHEMERAL_PG_DIR=
# Optional standard log export batch delay in ms; loopback QA uses short intervals.
OTEL_BLRP_SCHEDULE_DELAY=
# Optional standard trace export batch delay in ms; loopback QA uses short intervals.
OTEL_BSP_SCHEDULE_DELAY=
# Optional standard periodic metric export interval in ms; loopback QA uses short intervals.
OTEL_METRIC_EXPORT_INTERVAL=
# Local verification resource cap; 2 recommended on the shared VM; owner sizes production.
DOTNET_PROCESSOR_COUNT=
# Build tooling privacy flag; verification exports 1.
DOTNET_CLI_TELEMETRY_OPTOUT=
# Build tooling output flag; verification exports 1.
DOTNET_NOLOGO=
# Optional .NET installation root for SBOM tooling; SDK discovery used when blank.
DOTNET_ROOT=

# Live map: credential-free HTTPS tile template or none for outline-only mode.
CIVICOPS_MAP_TILE_URL=
# Plain-text attribution; default © OpenStreetMap contributors; no HTML or credentials.
CIVICOPS_MAP_ATTRIBUTION=
# Crew marker freshness in minutes, 1–240; default 15. Live pings require active shift and consent.
CIVICOPS_MAP_CREW_STALE_MINUTES=

# Native crew OIDC public client audience; blank disables native OIDC. Pairing remains available.
CIVICOPS_CREW_OIDC_CLIENT_ID=

# Omnichannel mode simulated|disabled|configured; explicit demo always simulated.
CIVICOPS_CHANNEL_MODE=
# Owner-managed base64 32-byte AES-GCM/contact-HMAC key; required outside explicit demo.
CIVICOPS_CHANNEL_ENCRYPTION_KEY=
# Optional absolute mounted file for CIVICOPS_CHANNEL_ENCRYPTION_KEY; blank uses environment secret.
CIVICOPS_CHANNEL_ENCRYPTION_KEY_FILE=
# Trusted relay HMAC key; gateway verifies native provider authentication first.
CIVICOPS_CHANNEL_INGRESS_SECRET=
# Optional absolute mounted file for CIVICOPS_CHANNEL_INGRESS_SECRET; blank uses environment secret.
CIVICOPS_CHANNEL_INGRESS_SECRET_FILE=
# Trusted HTTPS public origin plus /m/slug when used; exact native-signature URL binding.
CIVICOPS_CHANNEL_WEBHOOK_BASE_URL=
# Explicit true permits one named-human-approved configured send; blank disables external sends.
CIVICOPS_CHANNEL_SEND_ENABLED=
# Conversation/message/draft retention 1–30 days; default30; suppression hashes persist until START.
CIVICOPS_CHANNEL_RETENTION_DAYS=
# Twilio native callback HMAC and outbound Basic Auth; owner managed, never a demo credential.
CIVICOPS_TWILIO_AUTH_TOKEN=
# Optional absolute mounted file for CIVICOPS_TWILIO_AUTH_TOKEN; blank uses environment secret.
CIVICOPS_TWILIO_AUTH_TOKEN_FILE=
# Twilio account SID; native callbacks must match configured account.
CIVICOPS_TWILIO_ACCOUNT_SID=
# Twilio municipal E.164 number; inbound receiver must match.
CIVICOPS_TWILIO_FROM_NUMBER=
# Clickatell outbound SMS authorization key.
CIVICOPS_CLICKATELL_API_KEY=
# Optional absolute mounted file for CIVICOPS_CLICKATELL_API_KEY; blank uses environment secret.
CIVICOPS_CLICKATELL_API_KEY_FILE=
# Clickatell configured custom callback header X-CivicOps-Clickatell-Token; relay also required.
CIVICOPS_CLICKATELL_CALLBACK_SECRET=
# Optional absolute mounted file for CIVICOPS_CLICKATELL_CALLBACK_SECRET; blank uses environment secret.
CIVICOPS_CLICKATELL_CALLBACK_SECRET_FILE=
# Clickatell municipal E.164 receiver/sender number.
CIVICOPS_CLICKATELL_FROM_NUMBER=
# Meta native X-Hub-Signature-256 app secret.
CIVICOPS_WHATSAPP_APP_SECRET=
# Optional absolute mounted file for CIVICOPS_WHATSAPP_APP_SECRET; blank uses environment secret.
CIVICOPS_WHATSAPP_APP_SECRET_FILE=
# Meta webhook verification challenge token; constant-time checked.
CIVICOPS_WHATSAPP_VERIFY_TOKEN=
# Optional absolute mounted file for CIVICOPS_WHATSAPP_VERIFY_TOKEN; blank uses environment secret.
CIVICOPS_WHATSAPP_VERIFY_TOKEN_FILE=
# Meta WhatsApp outbound bearer token; no startup/provider calls.
CIVICOPS_WHATSAPP_ACCESS_TOKEN=
# Optional absolute mounted file for CIVICOPS_WHATSAPP_ACCESS_TOKEN; blank uses environment secret.
CIVICOPS_WHATSAPP_ACCESS_TOKEN_FILE=
# Meta business phone-number ID; callbacks must match configured receiver.
CIVICOPS_WHATSAPP_PHONE_NUMBER_ID=
# Optional owner-provisioned ElevenLabs inbound SIP destination; blank uses IVR. Live PBX acceptance pending.
CIVICOPS_ELEVENLABS_INBOUND_SIP_URI=
# Municipal PBX callback shared secret; constant-time X-CivicOps-Sip-Token verification in relay/native adapter.
CIVICOPS_SIP_CALLBACK_SECRET=
# Optional mounted secret file for the municipal PBX callback secret.
CIVICOPS_SIP_CALLBACK_SECRET_FILE=
# Loopback native-auth relay port; blank defaults5092; public TLS termination owner controlled.
CIVICOPS_CHANNEL_RELAY_PORT=
# Relay target must be literal loopback HTTP CivicOps origin; blank defaultshttp://127.0.0.1:5080.
CIVICOPS_CHANNEL_RELAY_TARGET=
# Active SOS follow-up location window; bounded by the server (default 30 minutes).
CIVICOPS_SOS_LOCATION_WINDOW_MINUTES=
# Control-room acknowledgement target; bounded by the server (default 60 seconds).
CIVICOPS_SOS_ACK_TARGET_SECONDS=
# Pocket-trigger cancellation window after a confirmed SOS; bounded to 3–60 seconds.
CIVICOPS_SOS_CANCEL_WINDOW_SECONDS=
