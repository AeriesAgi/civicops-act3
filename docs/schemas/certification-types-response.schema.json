{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/certification-types-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "certificationTypes": {
      "type": "array",
      "items": {
        "$ref": "work-order-catalog.schema.json#/properties/certificationTypes/items"
      },
      "minItems": 1,
      "maxItems": 500
    }
  },
  "required": [
    "version",
    "certificationTypes"
  ]
}
