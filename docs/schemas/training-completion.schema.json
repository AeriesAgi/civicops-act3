{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/training-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "moduleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "workOrderTypeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 80
    },
    "skillsPractised": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
        "maxLength": 80
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "passed": {
      "type": "boolean"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "deviceClientLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workerId",
    "moduleId",
    "workOrderTypeCode",
    "skillsPractised",
    "score",
    "passed",
    "durationSeconds",
    "attempt",
    "deviceClientLabel",
    "evidenceHash",
    "completedAt"
  ]
}
