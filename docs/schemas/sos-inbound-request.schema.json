{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/sos-inbound-request.schema.json",
  "title": "Synthetic SMS or WhatsApp SOS keyword",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel", "sender", "message", "tenantId"],
  "properties": {
    "channel": {"type": "string", "enum": ["sms", "whatsapp"]},
    "sender": {"type": "string", "minLength": 2, "maxLength": 320},
    "message": {"type": "string", "minLength": 1, "maxLength": 320},
    "tenantId": {"type": ["string", "null"], "maxLength": 64}
  },
  "description": "Only reviewed SOS keywords are routed. Provider delivery is disabled in the synthetic mode."
}
