{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/work-order-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "workOrderTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
            "maxLength": 80
          },
          "serviceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "hazardClass": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "critical"
            ]
          },
          "requiredSkills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
                  "maxLength": 80
                },
                "minimumLevel": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "code",
                "minimumLevel"
              ]
            },
            "minItems": 1,
            "maxItems": 500
          },
          "requiredCertifications": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 500
          },
          "ppe": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "procedureSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "slaTargetMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 43200
          }
        },
        "required": [
          "code",
          "serviceCode",
          "category",
          "department",
          "title",
          "description",
          "hazardClass",
          "requiredSkills",
          "requiredCertifications",
          "ppe",
          "procedureSteps",
          "slaTargetMinutes"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "discipline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "required": [
          "code",
          "name",
          "discipline"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "certificationTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "validityMonths": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "issuingBasis": {
            "type": "string",
            "enum": [
              "classroom",
              "field-assessment",
              "simulation",
              "external"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "validityMonths",
          "issuingBasis"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    }
  },
  "required": [
    "version",
    "workOrderTypes",
    "skills",
    "certificationTypes"
  ]
}
