{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/training-certification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "certificationTypeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 80
    },
    "completionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "supervisorSignOff": {
      "type": "boolean",
      "const": true
    },
    "signOffReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  },
  "required": [
    "workerId",
    "certificationTypeCode",
    "completionId",
    "supervisorSignOff",
    "signOffReference"
  ]
}
