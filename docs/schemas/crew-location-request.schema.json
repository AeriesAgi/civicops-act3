{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicops.example.invalid/schemas/crew-location-request.schema.json",
  "title": "Consent-gated on-shift crew location batch",
  "description": "Current device-owned shift and current purpose consent are verified server-side, including on retries. No off-shift, withdrawn, biometric or covert collection is accepted. Batch points must share a UTC date, arrive in capture order at the tenant interval (one-second timer tolerance), and satisfy its accuracy bound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId", "shiftId", "consentId", "visibleIndicator", "points"],
  "properties": {
    "operationId": {"type": "string", "minLength": 8, "maxLength": 128},
    "shiftId": {"type": "string", "minLength": 1, "maxLength": 64},
    "consentId": {"type": "string", "minLength": 1, "maxLength": 64},
    "visibleIndicator": {"type": "boolean", "const": true},
    "points": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["longitude", "latitude", "accuracyMeters", "capturedAt"],
        "properties": {
          "longitude": {"type": "number", "minimum": 16, "maximum": 33},
          "latitude": {"type": "number", "minimum": -35, "maximum": -22},
          "accuracyMeters": {"type": "number", "minimum": 1, "maximum": 1000},
          "capturedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "example": {
    "operationId": "synthetic-location-operation-001",
    "shiftId": "shift-synthetic-example",
    "consentId": "consent-synthetic-example",
    "visibleIndicator": true,
    "points": [{"longitude": 30.975, "latitude": -29.91, "accuracyMeters": 20, "capturedAt": "2026-10-09T12:00:00Z"}]
  }
}
