{
  "tool_config": {
    "type": "webhook",
    "name": "lookup_case_status",
    "description": "Look up minimal public status for a case reference. No contact information or transcript is returned.",
    "response_timeout_secs": 20,
    "api_schema": {
      "url": "{{PUBLIC_BASE_URL}}/api/channels/elevenlabs/tools/lookup_case_status",
      "method": "POST",
      "request_headers": {
        "Authorization": {
          "secret_id": "{{ELEVENLABS_WORKSPACE_TOOL_SECRET_ID}}"
        },
        "X-CivicOps-Conversation-Id": {
          "variable_name": "system__conversation_id"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string",
            "dynamic_variable": "system__conversation_id"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "turn_id": {
            "type": "string",
            "description": "A stable request identifier for this logical tool operation. Reuse it unchanged if retrying. Do not reuse it for different information."
          },
          "reference_number": {
            "type": "string",
            "description": "The exact CIV case reference supplied by the resident."
          }
        },
        "required": [
          "conversation_id",
          "turn_id",
          "reference_number"
        ]
      }
    }
  }
}
